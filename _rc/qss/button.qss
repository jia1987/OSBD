/* 深色主题按钮 */
PushButton, ToolButton {
    color: #E8EAF0;
    background-color: #2A2F3D;
    border: 1px solid #3A4152;
    border-radius: 6px;
    padding: 5px 12px 6px 12px;
    outline: none;
}

ToolButton {
    padding: 5px 9px 6px 8px;
}

PushButton[isPlaceholderText=true] {
    color: #8B93A7;
}

PushButton:hover, ToolButton:hover {
    background-color: #333B4D;
    border-color: #465066;
}

PushButton:pressed, ToolButton:pressed {
    color: #B9C0D0;
    background-color: #262C3A;
}

PushButton:disabled, ToolButton:disabled {
    color: #6B7280;
    background-color: #232733;
    border: 1px solid #2E3444;
}

/* 选中/主色态 */
PrimaryPushButton,
PrimaryToolButton,
ToggleButton:checked,
ToggleToolButton:checked {
    color: #FFFFFF;
    background-color: #2E9BFF;
    border: 1px solid #2E9BFF;
}

PrimaryPushButton:hover,
PrimaryToolButton:hover,
ToggleButton:checked:hover,
ToggleToolButton:checked:hover {
    background-color: #4AA8FF;
    border: 1px solid #4AA8FF;
}

PrimaryPushButton:pressed,
PrimaryToolButton:pressed,
ToggleButton:checked:pressed,
ToggleToolButton:checked:pressed {
    color: rgba(255, 255, 255, 0.7);
    background-color: #1F7ED6;
    border: 1px solid #1F7ED6;
}

PrimaryPushButton:disabled,
PrimaryToolButton:disabled,
ToggleButton:checked:disabled,
ToggleToolButton:checked:disabled {
    color: rgba(255, 255, 255, 0.6);
    background-color: #3A4152;
    border: 1px solid #3A4152;
}

/* 透明按钮 */
TransparentToolButton,
TransparentPushButton {
    background-color: transparent;
    border: none;
    border-radius: 5px;
    margin: 0;
    color: #E8EAF0;
}

TransparentToolButton:hover,
TransparentPushButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
}

TransparentToolButton:pressed,
TransparentPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.04);
    border: none;
}

TransparentToolButton:disabled,
TransparentPushButton:disabled {
    color: #6B7280;
    background-color: transparent;
    border: none;
}

/* 单选(深色) */
RadioButton {
    min-height: 24px;
    max-height: 24px;
    background-color: transparent;
    color: #E8EAF0;
}

RadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #465066;
    background-color: #2A2F3D;
    margin-right: 4px;
}

RadioButton::indicator:hover {
    border-color: #2E9BFF;
}

RadioButton::indicator:checked {
    height: 22px;
    width: 22px;
    border: none;
    border-radius: 11px;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 #FFFFFF,
            stop:0.5 #FFFFFF,
            stop:0.6 #2E9BFF,
            stop:1 #2E9BFF);
}

RadioButton:disabled {
    color: #6B7280;
}

RadioButton::indicator:disabled {
    border: 2px solid #3A4152;
    background-color: transparent;
}

HyperlinkButton {
    padding: 6px 12px 6px 12px;
    color: #2E9BFF;
    border: none;
    border-radius: 6px;
    background-color: transparent;
}

HyperlinkButton:hover {
    color: #4AA8FF;
    background-color: rgba(46, 155, 255, 0.10);
    border: none;
}

HyperlinkButton:pressed {
    color: #1F7ED6;
    background-color: rgba(46, 155, 255, 0.06);
    border: none;
}

HyperlinkButton:disabled {
    color: #6B7280;
    background-color: transparent;
    border: none;
}
