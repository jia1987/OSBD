/* Fluent 风格 ComboBox */
QComboBox {
    border: 1px solid #C0C0C0;   /* 浅灰边框 */
    border-radius: 6px;           /* 圆角 */
    padding: 4px 8px;             /* 内边距 */
    background-color: #FFFFFF;    /* 背景白色 */
    min-height: 18px;
    color: #333333;
}

QComboBox:hover {
    border: 1px solid #0078D4;   /* 悬停边框蓝色 */
}

QComboBox:focus {
    border: 1px solid #0078D4;   /* 聚焦边框蓝色 */
    background-color: #FFFFFF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #C0C0C0;
    border-radius: 0 6px 6px 0;
}

QComboBox::down-arrow {
    image: url(down_arrow.png);  /* 可替换为你的箭头图片 */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #C0C0C0;
    selection-background-color: #E5F1FB; /* 选中项背景 */
    selection-color: #0078D4;            /* 选中项文字颜色 */
    background-color: #FFFFFF;
    padding: 4px;
    outline: 0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid gray;
    border-radius: 0px;
    background-color: transparent;
}

QComboBox QAbstractItemView {
    border-radius: 10px;       /* 下拉列表圆角 */
    background-color: white;
    selection-background-color: lightblue;
}